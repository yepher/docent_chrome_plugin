{
  "manifest_version": 3,
  "name": "Jev Browser Agent",
  "version": "0.8.0",
  "description": "Type or say a prompt and let TypeSafe Jev act on the current tab, answer questions about it, and read it aloud.",
  "action": {
    "default_title": "Jev",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "contextMenus",
    "offscreen",
    "declarativeNetRequest",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open the Jev prompt"
    },
    "toggle-conversation": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Start or stop a hands-free conversation with Jev"
    },
    "pause-speaking": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume what Jev is saying"
    }
  },
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
